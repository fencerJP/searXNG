# ==============================================================================
# SearXNG & Gateway .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions & build artifacts
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
local/
cache/
gh-pages/

# PyInstaller & py2app
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage / analysis caches
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
.mypy_cache/
.pytype/
.ruff_cache/

# SQLite Databases & runtime storage
*.db
*.db-shm
*.db-wal
*.db-journal
tools/*.db*
tools/notes/
tests/sandbox/*.db*

# Node / Web UI build artifacts
/node_modules/
/package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environments & Version files
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.python-version
.govm/
.nvm/

# Generated files
searx/version_frozen.py
geckodriver.log
*.log

# Editors & IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.swp
*.swo
*~
.dir-locals.el
.DS_Store
